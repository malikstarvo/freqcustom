# Go Collector configuration for writing to TimescaleDB
# This collector runs as a standalone process alongside Freqtrade.
# Freqtrade reads from TimescaleDB (read-only) via TimescaleDataProvider.

# Ensure the collector writes to the SAME TimescaleDB instance
# and SAME hypertable schemas defined in docker/timescale_setup.sql

export TIMESCALE_DSN="postgresql://freqtrade:freqtrade@localhost:5432/freqtrade?sslmode=disable"

# Bybit WebSocket streams to enable:
export BYBIT_ENABLE_WS=true
export BYBIT_STREAM_OHLCV=true
export BYBIT_STREAM_ORDERBOOK=false
export BYBIT_STREAM_OPEN_INTEREST=true
export BYBIT_STREAM_FUNDING_RATE=true
export BYBIT_STREAM_LIQUIDATIONS=true
export BYBIT_STREAM_LS_RATIO=true

# Symbols to collect (comma-separated):
export BYBIT_SYMBOLS="BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT"

# Timeframes to aggregate:
export BYBIT_TIMEFRAMES="15m,1h,4h"

# Feature computation:
export FEATURE_SET_ID=1
export COMPUTE_EMA=true
export COMPUTE_RSI=true
export COMPUTE_ATR=true
export COMPUTE_ADX=true
export COMPUTE_VOLATILITY=true
export COMPUTE_VOLUME_EMA=true
