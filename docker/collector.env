# Go Collector configuration for writing to TimescaleDB
# This collector runs as a standalone process or Docker container alongside Freqtrade.
# Freqtrade reads from TimescaleDB (read-only) via TimescaleDataProvider.
# 
# When running OUTSIDE Docker (bare metal): use localhost
#   TIMESCALE_DSN="postgresql://freqtrade:password@localhost:5432/freqtrade?sslmode=disable"
#
# When running INSIDE Docker (compose): use the service name
#   TIMESCALE_DSN="postgresql://freqtrade:password@timescaledb:5432/freqtrade?sslmode=disable"

TIMESCALE_DSN="postgresql://freqtrade:${TIMESCALE_PASSWORD:-freqtrade}@timescaledb:5432/freqtrade?sslmode=disable"

# Bybit WebSocket streams to enable:
BYBIT_ENABLE_WS=true
BYBIT_STREAM_OHLCV=true
BYBIT_STREAM_ORDERBOOK=false
BYBIT_STREAM_OPEN_INTEREST=true
BYBIT_STREAM_FUNDING_RATE=true
BYBIT_STREAM_LIQUIDATIONS=true
BYBIT_STREAM_LS_RATIO=true

# Symbols to collect (comma-separated):
BYBIT_SYMBOLS="BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,BNBUSDT"

# Timeframes to aggregate:
BYBIT_TIMEFRAMES="15m,1h,4h"

# Feature computation:
FEATURE_SET_ID=1
COMPUTE_EMA=true
COMPUTE_RSI=true
COMPUTE_ATR=true
COMPUTE_ADX=true
COMPUTE_VOLATILITY=true
COMPUTE_VOLUME_EMA=true
