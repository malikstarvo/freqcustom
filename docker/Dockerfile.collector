# Go Collector Dockerfile
# Build: docker build -t go-collector -f Dockerfile.collector .
# Requires Go collector source in ./go-collector/ directory
# Clone from your Go collector repository first:
#   git clone <go-collector-repo-url> go-collector

FROM golang:1.22-alpine AS builder

WORKDIR /app
COPY go-collector/ ./
RUN go mod download 2>/dev/null || true
RUN CGO_ENABLED=0 GOOS=linux go build -o collector .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /app/collector /usr/local/bin/collector
CMD ["collector"]
