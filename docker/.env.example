# TimescaleDB password (used by docker-compose.monitoring.yml)
TIMESCALE_PASSWORD=change_me_please

# Grafana admin password
GRAFANA_PASSWORD=admin

# Freqtrade API credentials (for dashboard login)
API_USERNAME=admin
API_PASSWORD=admin

# Go Collector configuration (optional, if running collector separately)
TIMESCALE_DSN=postgresql://freqtrade:${TIMESCALE_PASSWORD}@timescaledb:5432/freqtrade?sslmode=disable
BYBIT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BYBIT_TIMEFRAMES=15m,1h,4h
