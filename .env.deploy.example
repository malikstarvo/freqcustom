# =========================================================
# .env.deploy.example — Konfigurasi deploy web
# =========================================================
# Copy file ini ke .env.deploy, lalu isi sesuai VPS kamu.
#
#   cp .env.deploy.example .env.deploy
# =========================================================

# User + IP VPS (wajib diisi)
VPS_HOST=user@1.2.3.4

# Path project di VPS (default: /home/freqtrade/freqtrade)
# VPS_PATH=/home/freqtrade/freqtrade

# Path hasil build di VPS (default otomatis: $VPS_PATH/web/out)
# VPS_WEB_DIR=/home/freqtrade/freqtrade/web/out
