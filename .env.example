# Freqtrade Client Configuration
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# python-dotenv auto-loads .env from the current directory.

# API Server URL (required)
# FT_SERVER_URL=http://YOUR_SERVER_IP:8080

# API Authentication
# FT_SERVER_USERNAME=admin
# FT_SERVER_PASSWORD=admin

# SSH Host — for backtest history, entrylog, and backtest run commands
# FT_SSH_HOST=YOUR_SERVER_IP

# SSH user (default: ubuntu)
# FT_SSH_USER=ubuntu

# Docker compose directory on server (default: /home/ubuntu/freqtrade)
# FT_COMPOSE_DIR=/home/ubuntu/freqtrade
