{
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "dry_run": true,
    "timeframe": "15m",
    "trading_mode": "spot",
    "margin_mode": "isolated",
    "exchange": {
        "name": "bybit",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT"
        ]
    },
    "pairlists": [
        { "method": "StaticPairList" }
    ],
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "strategy": "MultiAgentStrategy",
    "strategy_path": "user_data/strategies",
    "freqaimodel": "XGBoostGridSearchModel",
    "freqaimodel_path": "user_data/freqaimodels",
    "freqai": {
        "enabled": true,
        "purge_old_models": 3,
        "train_period_days": 90,
        "backtest_period_days": 30,
        "identifier": "multi_agent_v1",
        "feature_parameters": {
            "include_timeframes": ["15m"],
            "include_corr_pairlist": [],
            "label_period_candles": 4,
            "feature_columns": [
                "ema20", "ema50", "ema200",
                "rsi14", "atr14", "adx14",
                "volume_ema20", "volatility14",
                "funding_rate", "oi_delta_1_pct",
                "ls_ratio", "liq_long_usd", "liq_short_usd"
            ],
            "indicator_periods_candles": [14, 20, 50, 200]
        },
        "data_split_parameters": {
            "test_size": 0.2
        },
        "model_training_parameters": {
            "max_depth": 5,
            "learning_rate": 0.05,
            "n_estimators": 500,
            "subsample": 0.8,
            "colsample_bytree": 0.8,
            "objective": "binary:logistic",
            "eval_metric": "auc",
            "random_state": 42,
            "early_stopping_rounds": 50
        },
        "grid_search_parameters": {
            "max_depth": [3, 5],
            "learning_rate": [0.03, 0.05, 0.1],
            "n_estimators": [200, 500],
            "subsample": [0.8, 1.0],
            "colsample_bytree": [0.8, 1.0]
        },
        "freqaimodel": "XGBoostGridSearchModel",
        "freqaimodel_path": "user_data/freqaimodels",
        "fit_live_predictions_candles": 4
    },
    "timescaledb": {
        "enabled": true,
        "database_url": "postgresql://freqtrade:freqtrade@localhost:5432/freqtrade",
        "feature_set_id": 1
    },
    "paper_trader": {
        "symbol": "BTCUSDT",
        "timeframe": "15m",
        "initial_capital": 10000,
        "commission": 0.00055,
        "slippage": 0.0005,
        "atr_multiplier": 2.0,
        "holding_bars": 24,
        "poll_interval_sec": 60,
        "risk_per_trade_pct": 1.0,
        "max_daily_drawdown_pct": 5.0,
        "max_total_drawdown_pct": 15.0,
        "long_threshold": 60.0,
        "short_threshold": 40.0,
        "ml_api_url": ""
    },
    "edge_study": {
        "database_url": "postgresql://freqtrade:freqtrade@localhost:5432/freqtrade"
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "username": "admin",
        "password": "admin",
        "jwt_secret_key": "SomethingRandomVeryLongStringAtLeast32Chars!"
    },
    "internals": {
        "process_throttle_secs": 5
    },
    "bot_name": "FreqTrade AI"
}
